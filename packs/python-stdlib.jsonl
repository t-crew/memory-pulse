{"name":"python-stdlib","version":"1.0.0","description":"Standard library modules and functions removed or deprecated in Python 3.12, 3.13 and 3.14.","stack":"python"}
{"id":"imp-module","statement":"the imp module was removed in Python 3.12","patterns":["/^[ \\t]*(?:import[ \\t]+imp\\b(?![ \\t]*\\.)|from[ \\t]+imp[ \\t]+import\\b)/m"],"paths":["**/*.py"],"severity":"warn","replacement":"importlib (importlib.util.find_spec, importlib.import_module, importlib.reload)","source":"https://docs.python.org/3/whatsnew/3.12.html","verified":"2026-11-21"}
{"id":"distutils","statement":"the distutils package was removed from the standard library in Python 3.12; it imports only where setuptools provides it","patterns":["/^[ \\t]*(?:import|from)[ \\t]+distutils\\b/m"],"paths":["**/*.py"],"severity":"warn","replacement":"setuptools, packaging, shutil.which, sysconfig","source":"https://docs.python.org/3/whatsnew/3.12.html","verified":"2026-11-21"}
{"id":"asyncore-asynchat-smtpd","statement":"asyncore, asynchat and smtpd were removed in Python 3.12","patterns":["/^[ \\t]*(?:import|from)[ \\t]+(?:asyncore|asynchat|smtpd)\\b(?![.\\w])/m"],"paths":["**/*.py"],"severity":"warn","replacement":"asyncio; aiosmtpd in place of smtpd","source":"https://docs.python.org/3/whatsnew/3.12.html","verified":"2026-11-21"}
{"id":"unittest-aliases","statement":"the unittest.TestCase aliases assertEquals, assertNotEquals, assertAlmostEquals, assertNotAlmostEquals, assertRegexpMatches, assertNotRegexpMatches and assertRaisesRegexp were removed in Python 3.12","patterns":["/\\bself\\.(?:assertEquals|assertNotEquals|assertAlmostEquals|assertNotAlmostEquals|assertRegexpMatches|assertNotRegexpMatches|assertRaisesRegexp)\\(/"],"paths":["**/*.py"],"severity":"block","replacement":"assertEqual, assertNotEqual, assertAlmostEqual, assertNotAlmostEqual, assertRegex, assertNotRegex, assertRaisesRegex","source":"https://docs.python.org/3/whatsnew/3.12.html","verified":"2026-11-21"}
{"id":"safeconfigparser","statement":"configparser.SafeConfigParser was removed in Python 3.12","patterns":["/\\bconfigparser\\.SafeConfigParser\\b/","/^[ \\t]*from[ \\t]+configparser[ \\t]+import[ \\t]+[^\\n#]{0,200}\\bSafeConfigParser\\b/m"],"paths":["**/*.py"],"severity":"block","replacement":"configparser.ConfigParser","source":"https://docs.python.org/3/whatsnew/3.12.html","verified":"2026-11-21"}
{"id":"locale-format","statement":"locale.format() was removed in Python 3.12","patterns":["/(?<![\\w.])locale\\.format\\(/"],"paths":["**/*.py"],"severity":"block","replacement":"locale.format_string()","source":"https://docs.python.org/3/whatsnew/3.12.html","verified":"2026-11-21"}
{"id":"ssl-wrap-socket","statement":"ssl.wrap_socket() and ssl.match_hostname() were removed in Python 3.12","patterns":["/(?<![\\w.])ssl\\.(?:wrap_socket|match_hostname)\\(/"],"paths":["**/*.py","!**/test/**","!**/tests/**","!**/test_*.py","!**/*_test.py"],"severity":"block","replacement":"ssl.create_default_context() and SSLContext.wrap_socket(sock, server_hostname=host)","source":"https://docs.python.org/3/whatsnew/3.12.html","verified":"2026-11-21"}
{"id":"datetime-utcnow","statement":"datetime.utcnow() and datetime.utcfromtimestamp() are deprecated since Python 3.12 and return naive datetimes","patterns":["/\\bdatetime\\.(?:utcnow\\(\\)|utcfromtimestamp\\()/"],"paths":["**/*.py"],"severity":"warn","replacement":"datetime.now(tz=datetime.UTC) and datetime.fromtimestamp(ts, tz=datetime.UTC)","source":"https://docs.python.org/3/whatsnew/3.12.html","verified":"2026-11-21"}
{"id":"pep594-modules","statement":"this module was removed from the standard library in Python 3.13 (PEP 594)","patterns":["/^[ \\t]*(?:import|from)[ \\t]+(?:aifc|audioop|cgi|cgitb|chunk|crypt|imghdr|mailcap|msilib|nis|nntplib|ossaudiodev|pipes|sndhdr|spwd|sunau|telnetlib|uu|xdrlib)\\b(?![.\\w])/m"],"paths":["**/*.py"],"severity":"warn","replacement":"the replacement the Python 3.13 notes give for the module: shlex.quote and subprocess for pipes, base64 for uu, filetype or puremagic for imghdr, pynntp for nntplib","source":"https://docs.python.org/3/whatsnew/3.13.html","verified":"2026-11-21"}
{"id":"ast-constant-aliases","statement":"ast.Num, ast.Str, ast.Bytes and ast.NameConstant were removed in Python 3.14","patterns":["/\\bast\\.(?:Num|Str|Bytes|NameConstant)\\b/"],"paths":["**/*.py"],"severity":"warn","replacement":"ast.Constant, and visit_Constant on a NodeVisitor","source":"https://docs.python.org/3/whatsnew/3.14.html","verified":"2026-11-21"}
{"id":"pkgutil-loaders","statement":"pkgutil.find_loader() and pkgutil.get_loader() were removed in Python 3.14","patterns":["/\\bpkgutil\\.(?:find_loader|get_loader)\\(/"],"paths":["**/*.py"],"severity":"block","replacement":"importlib.util.find_spec()","source":"https://docs.python.org/3/whatsnew/3.14.html","verified":"2026-11-21"}
{"id":"asyncio-iscoroutinefunction","statement":"asyncio.iscoroutinefunction() is deprecated in Python 3.14 and set for removal in 3.16","patterns":["/\\basyncio\\.iscoroutinefunction\\(/"],"paths":["**/*.py"],"severity":"warn","replacement":"inspect.iscoroutinefunction()","source":"https://docs.python.org/3/whatsnew/3.14.html","verified":"2026-11-21"}

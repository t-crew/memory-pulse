{"name":"supabase-auth","version":"1.0.0","description":"The deprecated Supabase Auth Helpers packages and supabase-js v1 auth methods.","stack":"supabase"}
{"id":"auth-helpers-packages","statement":"every @supabase/auth-helpers-* package is deprecated and no longer maintained","patterns":["/@supabase\\/auth-helpers-(?:nextjs|react|sveltekit|remix|shared)\\b/"],"paths":["**/*.{js,jsx,ts,tsx,mjs,cjs}","**/package.json"],"severity":"warn","replacement":"@supabase/ssr (createBrowserClient and createServerClient)","source":"https://raw.githubusercontent.com/supabase/auth-helpers/main/README.md","verified":"2026-11-21"}
{"id":"auth-session-user-v1","statement":"supabase.auth.session() and supabase.auth.user() are supabase-js v1 methods; v2 replaced them","patterns":["/\\bsupabase\\w*\\.auth\\.(?:session|user)\\(\\)/"],"paths":["**/*.{js,jsx,ts,tsx,mjs,cjs}"],"severity":"warn","replacement":"await supabase.auth.getSession() and await supabase.auth.getUser()","source":"https://supabase.com/docs/reference/javascript/v1/upgrade-guide","verified":"2026-11-21"}
{"id":"auth-sign-in-v1","statement":"auth.signIn() was deprecated in supabase-js v2 in favour of explicit methods","patterns":["/\\.auth\\.signIn\\(/"],"paths":["**/*.{js,jsx,ts,tsx,mjs,cjs}"],"severity":"warn","replacement":"signInWithPassword, signInWithOtp or signInWithOAuth","source":"https://supabase.com/docs/reference/javascript/v1/upgrade-guide","verified":"2026-11-21"}
{"id":"auth-update-v1","statement":"supabase.auth.update() is a supabase-js v1 method; v2 replaced it","patterns":["/\\bsupabase\\w*\\.auth\\.update\\(/"],"paths":["**/*.{js,jsx,ts,tsx,mjs,cjs}"],"severity":"warn","replacement":"supabase.auth.updateUser()","source":"https://supabase.com/docs/reference/javascript/v1/upgrade-guide","verified":"2026-11-21"}

{"name":"cloudflare-workers","version":"1.0.0","description":"Wrangler configuration and commands removed in Wrangler v4, and Workers features Cloudflare has deprecated.","stack":"cloudflare-workers"}
{"id":"node-compat","statement":"the node_compat config property was removed in Wrangler v4","patterns":["/^[ \\t]*node_compat[ \\t]*=/m","/\"node_compat\"[ \\t]*:/"],"paths":["**/wrangler.toml","**/wrangler.json","**/wrangler.jsonc"],"severity":"block","replacement":"compatibility_flags = [\"nodejs_compat\"]","source":"https://developers.cloudflare.com/workers/wrangler/migration/update-v3-to-v4/","verified":"2026-11-21"}
{"id":"legacy-assets","statement":"the legacy_assets config property was removed in Wrangler v4","patterns":["/^[ \\t]*legacy_assets[ \\t]*=/m","/\"legacy_assets\"[ \\t]*:/"],"paths":["**/wrangler.toml","**/wrangler.json","**/wrangler.jsonc"],"severity":"block","replacement":"Workers Static Assets: assets = { directory = \"./public\" }","source":"https://developers.cloudflare.com/workers/wrangler/migration/update-v3-to-v4/","verified":"2026-11-21"}
{"id":"wrangler-publish","statement":"wrangler publish and wrangler pages publish were removed in Wrangler v4","patterns":["/\\bwrangler[ \\t]+(?:pages[ \\t]+)?publish\\b/"],"paths":["**/package.json","**/*.{yml,yaml,sh}","**/Makefile*"],"severity":"block","replacement":"wrangler deploy, and wrangler pages deploy","source":"https://developers.cloudflare.com/workers/wrangler/deprecations/","verified":"2026-11-21"}
{"id":"usage-model","statement":"the usage_model config property no longer has any effect","patterns":["/^[ \\t]*usage_model[ \\t]*=/m","/\"usage_model\"[ \\t]*:/"],"paths":["**/wrangler.toml","**/wrangler.json","**/wrangler.jsonc"],"severity":"warn","replacement":"remove the line","source":"https://developers.cloudflare.com/workers/wrangler/deprecations/","verified":"2026-11-21"}
{"id":"workers-sites","statement":"Workers Sites is deprecated in Wrangler v4; Cloudflare says not to use it for new projects","patterns":["/^[ \\t]*\\[site\\]/m","/^[ \\t]*site[ \\t]*=[ \\t]*\\{/m","/\"site\"[ \\t]*:[ \\t]*\\{/"],"paths":["**/wrangler.toml","**/wrangler.json","**/wrangler.jsonc"],"severity":"warn","replacement":"Workers Static Assets: assets = { directory = \"./public\" }","source":"https://developers.cloudflare.com/workers/configuration/sites/","verified":"2026-11-21"}
{"id":"legacy-env","statement":"Service Environments, enabled by the legacy_env property, are deprecated","patterns":["/^[ \\t]*legacy_env[ \\t]*=/m","/\"legacy_env\"[ \\t]*:/"],"paths":["**/wrangler.toml","**/wrangler.json","**/wrangler.jsonc"],"severity":"warn","replacement":"Wrangler Environments: [env.<name>] sections","source":"https://developers.cloudflare.com/workers/wrangler/deprecations/","verified":"2026-11-21"}
{"id":"service-worker-syntax","statement":"Service Worker syntax is deprecated for Workers, though still supported (a browser service worker is a different thing: turn this rule off where the project ships one)","patterns":["/\\baddEventListener\\([ \\t]*[\"']fetch[\"']/"],"paths":["**/*.{js,jsx,ts,tsx,mjs,cjs}"],"severity":"warn","replacement":"a Module Worker: export default { async fetch(request, env, ctx) { ... } }","source":"https://developers.cloudflare.com/workers/reference/migrate-to-module-workers/","verified":"2026-11-21"}

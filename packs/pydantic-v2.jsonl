{"name":"pydantic-v2","version":"1.0.0","description":"Pydantic V1 imports, decorators, config keys and methods that Pydantic V2 removed, moved or deprecated.","stack":"pydantic"}
{"id":"basesettings-import","statement":"BaseSettings moved out of pydantic in V2","patterns":["/^[ \\t]*from[ \\t]+pydantic[ \\t]+import[ \\t]+[^\\n#]{0,200}\\bBaseSettings\\b/m","/\\bfrom[ \\t]+pydantic[ \\t]+import[ \\t]*\\([^)]{0,400}\\bBaseSettings\\b/","/(?<![\\w.])pydantic\\.BaseSettings\\b/"],"paths":["**/*.py"],"severity":"warn","replacement":"from pydantic_settings import BaseSettings (the pydantic-settings package)","source":"https://pydantic.dev/docs/validation/latest/get-started/migration/","verified":"2026-11-21"}
{"id":"generic-model","statement":"pydantic.generics.GenericModel was removed in V2","patterns":["/(?<![\\w.])pydantic\\.generics\\b/"],"paths":["**/*.py"],"severity":"warn","replacement":"class MyModel(BaseModel, Generic[T])","source":"https://pydantic.dev/docs/validation/latest/get-started/migration/","verified":"2026-11-21"}
{"id":"root-field","statement":"a __root__ field no longer defines a custom root model in V2","patterns":["/^[ \\t]+__root__[ \\t]*:/m"],"paths":["**/*.py"],"severity":"warn","replacement":"pydantic.RootModel","source":"https://pydantic.dev/docs/validation/latest/get-started/migration/","verified":"2026-11-21"}
{"id":"validator-decorator","statement":"@validator is deprecated in V2","patterns":["/^[ \\t]*from[ \\t]+pydantic[ \\t]+import[ \\t]+[^\\n#]{0,200}(?<![\\w])validator\\b/m","/\\bfrom[ \\t]+pydantic[ \\t]+import[ \\t]*\\([^)]{0,400}(?<![\\w])validator\\b/","/^[ \\t]*@(?:pydantic\\.)?validator\\(/m"],"paths":["**/*.py"],"severity":"warn","replacement":"@field_validator","source":"https://pydantic.dev/docs/validation/latest/get-started/migration/","verified":"2026-11-21"}
{"id":"root-validator","statement":"@root_validator is deprecated in V2","patterns":["/^[ \\t]*from[ \\t]+pydantic[ \\t]+import[ \\t]+[^\\n#]{0,200}\\broot_validator\\b/m","/\\bfrom[ \\t]+pydantic[ \\t]+import[ \\t]*\\([^)]{0,400}\\broot_validator\\b/","/^[ \\t]*@(?:pydantic\\.)?root_validator\\b/m"],"paths":["**/*.py"],"severity":"warn","replacement":"@model_validator","source":"https://pydantic.dev/docs/validation/latest/get-started/migration/","verified":"2026-11-21"}
{"id":"config-renamed-keys","statement":"this model config key was renamed in V2","patterns":["/^[ \\t]+(?:allow_population_by_field_name|orm_mode|anystr_strip_whitespace|anystr_lower|anystr_upper|max_anystr_length|min_anystr_length|schema_extra)[ \\t]*=/m","/\\bConfigDict\\([^)]{0,300}\\b(?:allow_population_by_field_name|orm_mode|anystr_strip_whitespace|validate_all|schema_extra)[ \\t]*=/"],"paths":["**/*.py"],"severity":"warn","replacement":"orm_mode -> from_attributes, allow_population_by_field_name -> populate_by_name, schema_extra -> json_schema_extra, anystr_strip_whitespace -> str_strip_whitespace, validate_all -> validate_default, in model_config = ConfigDict(...)","source":"https://pydantic.dev/docs/validation/latest/get-started/migration/","verified":"2026-11-21"}
{"id":"field-renamed-arguments","statement":"this Field argument was removed or renamed in V2","patterns":["/\\bField\\([^)\\n]{0,200}\\b(?:regex|min_items|max_items|allow_mutation|unique_items)[ \\t]*=/"],"paths":["**/*.py"],"severity":"warn","replacement":"regex -> pattern, min_items -> min_length, max_items -> max_length, allow_mutation -> frozen","source":"https://pydantic.dev/docs/validation/latest/get-started/migration/","verified":"2026-11-21"}
{"id":"deprecated-model-methods","statement":"this BaseModel method is deprecated in V2","patterns":["/\\.(?:parse_obj|parse_raw|parse_file|from_orm|update_forward_refs|schema_json)\\(/"],"paths":["**/*.py"],"severity":"warn","replacement":"parse_obj -> model_validate, parse_raw -> model_validate_json, from_orm -> model_validate with from_attributes=True, update_forward_refs -> model_rebuild, schema_json -> model_json_schema","source":"https://pydantic.dev/docs/validation/latest/get-started/migration/","verified":"2026-11-21"}
{"id":"validate-arguments","statement":"@validate_arguments was renamed in V2","patterns":["/(?<![\\w.])validate_arguments\\b/"],"paths":["**/*.py"],"severity":"warn","replacement":"@validate_call","source":"https://pydantic.dev/docs/validation/latest/get-started/migration/","verified":"2026-11-21"}

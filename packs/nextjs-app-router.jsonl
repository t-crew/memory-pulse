{"name":"nextjs-app-router","version":"1.0.0","description":"Pages Router APIs that do not work under app/, and request and cache APIs that Next.js 16 changed.","stack":"nextjs"}
{"id":"pages-data-fetching","statement":"getServerSideProps, getStaticProps, getStaticPaths and getInitialProps are replaced inside the app directory","patterns":["/\\bexport[ \\t]+(?:async[ \\t]+)?(?:function|const)[ \\t]+(?:getServerSideProps|getStaticProps|getStaticPaths)\\b/","/\\.getInitialProps[ \\t]*=/"],"paths":["**/app/**/{page,layout,route,template,default,loading,error,not-found}.{js,jsx,ts,tsx}"],"severity":"block","replacement":"fetch data in an async Server Component; generateStaticParams in place of getStaticPaths","source":"https://nextjs.org/docs/app/guides/migrating/app-router-migration","verified":"2026-11-21"}
{"id":"next-router-import","statement":"the useRouter hook imported from next/router is not supported in the app directory","patterns":["/\\bimport[ \\t]+(?!type\\b)[^;'\"]{0,300}\\b(?:useRouter|withRouter)\\b[^;'\"]{0,300}\\bfrom[ \\t]+[\"']next\\/router[\"']/","/\\bimport[ \\t]+Router\\b[^;'\"]{0,100}\\bfrom[ \\t]+[\"']next\\/router[\"']/","/\\brequire\\([ \\t]*[\"']next\\/router[\"'][ \\t]*\\)/"],"paths":["**/app/**/*.{js,jsx,ts,tsx,mts,cts}","!**/pages/**"],"severity":"warn","mentions":"skip","replacement":"useRouter, usePathname and useSearchParams from next/navigation","source":"https://nextjs.org/docs/app/guides/migrating/app-router-migration","verified":"2026-11-21"}
{"id":"next-head-import","statement":"next/head is replaced in the app directory by the built-in metadata support","patterns":["/\\bfrom[ \\t]+[\"']next\\/head[\"']/"],"paths":["**/app/**/*.{js,jsx,ts,tsx,mts,cts}","!**/pages/**"],"severity":"warn","replacement":"export const metadata, or generateMetadata","source":"https://nextjs.org/docs/app/guides/migrating/app-router-migration","verified":"2026-11-21"}
{"id":"sync-request-apis","statement":"synchronous access to cookies(), headers() and draftMode() is removed in Next.js 16; they return promises","patterns":["/(?<![.\\w$])(?:cookies|headers|draftMode)\\(\\)\\.(?!then\\b|catch\\b|finally\\b)[A-Za-z_]/"],"paths":["**/app/**/*.{js,jsx,ts,tsx,mts,cts}","!**/pages/**"],"severity":"warn","replacement":"(await cookies()).get(...), (await headers()).get(...), (await draftMode()).isEnabled","source":"https://nextjs.org/docs/app/guides/upgrading/version-16","verified":"2026-11-21"}
{"id":"revalidate-tag-single-argument","statement":"revalidateTag with a single argument is deprecated in Next.js 16","patterns":["/\\brevalidateTag\\([ \\t]*[^,()\\n]{1,80}\\)/"],"paths":["**/app/**/*.{js,jsx,ts,tsx,mts,cts}","!**/pages/**"],"severity":"warn","replacement":"revalidateTag(tag, 'max'), or updateTag(tag) in a Server Action for immediate expiry","source":"https://nextjs.org/docs/app/guides/upgrading/version-16","verified":"2026-11-21"}
{"id":"next-legacy-image","statement":"the next/legacy/image component is deprecated in Next.js 16","patterns":["/[\"']next\\/legacy\\/image[\"']/"],"paths":["**/*.{js,jsx,ts,tsx,mjs,cjs}"],"severity":"warn","replacement":"next/image","source":"https://nextjs.org/docs/app/guides/upgrading/version-16","verified":"2026-11-21"}
